# Copy to .env.local and fill in.
#
# AUTH_SECRET — used by NextAuth to sign session tokens.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# ANTHROPIC_API_KEY — used by:
#   - the runtime coach (lib/agent/stream.ts via @anthropic-ai/claude-agent-sdk)
#   - the offline ingestion script (scripts/ingest-book.ts via @anthropic-ai/sdk)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
